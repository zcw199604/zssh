#!/usr/bin/env bash
# zssh（Windows / Git Bash 版）：通过 Git Bash 自带的 ssh 执行远程命令，密码由 Windows 凭据管理器直接交给 ssh
#   zssh <alias> '<remote command>'        在 ~/.ssh/config 中的主机别名上执行命令
#   zssh --add <alias> <user@host[:port]>  在 ~/.ssh/config 追加主机别名，并可接着录入密码
#   zssh --set <alias>                     录入/更新该别名的密码（交互输入，仅限人工在终端执行）
set -eu

# 凭据管理器中的普通凭据：目标名 ssh_pass_<alias>，用户名 alias；读写由同目录的 zssh-cred.ps1 完成
TARGET_PREFIX=ssh_pass_
SSH=/usr/bin/ssh
SSH_CONFIG="$HOME/.ssh/config"
script_dir=$(cd "$(dirname "$0")" && pwd)

cred() {
    powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass \
        -File "$(cygpath -w "$script_dir/zssh-cred.ps1")" "$@"
}

# 被 ssh 作为 SSH_ASKPASS 回调时：只应答密码提示，主机指纹确认、密钥口令等其他提示一律拒绝
if [ -n "${ZSSH_ASKPASS_ALIAS:-}" ]; then
    case "${1:-}" in
        *assword*) cred get "$ZSSH_ASKPASS_ALIAS"; exit $? ;;
        *) exit 1 ;;
    esac
fi

usage() {
    sed -n '3,5p' "$0" >&2
    exit 2
}

die() {
    echo "zssh: $*" >&2
    exit 1
}

check_alias() {
    case "$1" in
        '' | -* | *[!A-Za-z0-9._-]*) die "别名只能包含字母、数字、点、下划线和连字符，且不能以 - 开头: $1" ;;
    esac
}

set_password() {
    check_alias "$1"
    IFS= read -rs -p "为 $1 输入密码: " first || die "未读取到输入"
    echo >&2
    IFS= read -rs -p "再次输入确认: " second || die "未读取到输入"
    echo >&2
    [ -n "$first" ] || die "密码为空，未保存"
    [ "$first" = "$second" ] || die "两次输入不一致，未保存"
    printf '%s' "$first" | cred set "$1"
    echo "已保存到 Windows 凭据管理器: $TARGET_PREFIX$1"
}

add_host() {
    alias_name=$1
    target=$2
    check_alias "$alias_name"

    case "$target" in
        *@*) ;;
        *) die "目标格式应为 user@host[:port]: $target" ;;
    esac
    user=${target%%@*}
    host_port=${target#*@}
    host=${host_port%%:*}
    port=22
    [ "$host_port" = "$host" ] || port=${host_port#*:}
    case "$user" in '' | *[!A-Za-z0-9._-]*) die "用户名不合法: $user" ;; esac
    case "$host" in '' | *[!A-Za-z0-9._-]*) die "主机地址不合法: $host" ;; esac
    case "$port" in '' | *[!0-9]*) die "端口不合法: $port" ;; esac

    mkdir -p "$HOME/.ssh"
    if [ -f "$SSH_CONFIG" ] && awk -v a="$alias_name" '
        tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i == a) found = 1 }
        END { exit !found }' "$SSH_CONFIG"; then
        die "别名已存在于 $SSH_CONFIG: $alias_name"
    fi

    printf '\nHost %s\n    HostName %s\n    User %s\n    Port %s\n' \
        "$alias_name" "$host" "$user" "$port" >>"$SSH_CONFIG"
    echo "已添加 Host $alias_name -> $user@$host:$port"

    # 无终端（如被脚本调用）时读到 EOF，跳过录入密码
    printf '是否为 %s 录入密码到凭据管理器？密钥登录选 n [Y/n] ' "$alias_name"
    read -r answer || { answer=n; echo; }
    case "$answer" in
        '' | [Yy]*) set_password "$alias_name" ;;
        *) echo "已跳过；需要时执行: zssh --set $alias_name" ;;
    esac
}

case "${1:-}" in
    --set)
        [ $# -eq 2 ] || usage
        set_password "$2"
        exit 0
        ;;
    --add)
        [ $# -eq 3 ] || usage
        add_host "$2" "$3"
        exit 0
        ;;
    '' | -*) usage ;;
esac
[ $# -ge 2 ] || usage

alias_name=$1
shift
check_alias "$alias_name"

# 始终挂上 askpass：密钥认证成功时不会回调；需要密码时从凭据管理器读取，没有该凭据则认证失败，不会卡住。
# Git Bash 下 ControlMaster 不可靠，因此不做连接复用。
ZSSH_ASKPASS_ALIAS=$alias_name SSH_ASKPASS="$script_dir/$(basename "$0")" SSH_ASKPASS_REQUIRE=force \
    exec "$SSH" -o StrictHostKeyChecking=accept-new -o NumberOfPasswordPrompts=1 -o ConnectTimeout=10 \
    "$alias_name" "$@"
