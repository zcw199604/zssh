#!/usr/bin/env bash
# zssh（Windows / Git Bash 版）：通过 Git Bash 自带的 ssh 执行远程命令，密码由 Windows 凭据管理器直接交给 ssh
#   zssh <alias> '<remote command>'        在 ~/.ssh/config 中的主机别名上执行命令
#   zssh --add <alias> <user@host[:port]>  在 ~/.ssh/config 追加主机别名，并可接着录入密码
#   zssh --set <alias>                     录入/更新该别名的密码（交互输入，仅限人工在终端执行）
#   zssh --probe <alias>                   只握手不登录，检查老服务器需要补哪些算法配置
#   zssh -t <alias> [remote command]       交互式登录（或运行需要终端的命令），仅限人工在终端使用
#   zssh --put <alias> <local> <remote>    上传文件或目录（scp -r）
#   zssh --get <alias> <remote> <local>    下载文件或目录（scp -r）
#   zssh --forward <alias> <[bind:]port:host:hostport>  本地端口转发（ssh -L），Ctrl-C 结束，仅限人工在终端使用
set -eu

# 凭据管理器中的普通凭据：目标名 ssh_pass_<alias>，用户名 alias；读写由同目录的 zssh-cred.ps1 完成
TARGET_PREFIX=ssh_pass_
SSH=/usr/bin/ssh
SCP=/usr/bin/scp
SSH_CONFIG="$HOME/.ssh/config"
script_dir=$(cd "$(dirname "$0")" && pwd)
self="$script_dir/$(basename "$0")"

cred() {
    powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass \
        -File "$(cygpath -w "$script_dir/zssh-cred.ps1")" "$@"
}

# 被 ssh 作为 SSH_ASKPASS 回调时：只应答密码提示，主机指纹确认、密钥口令等其他提示一律拒绝
if [ -n "${ZSSH_ASKPASS_ALIAS:-}" ]; then
    case "${1:-}" in
        *assword*) cred get "$ZSSH_ASKPASS_ALIAS"; exit $? ;;
        *) exit 1 ;;
    esac
fi

usage() {
    sed -n '3,10p' "$0" >&2
    exit 2
}

die() {
    echo "zssh: $*" >&2
    exit 1
}

check_alias() {
    case "$1" in
        '' | -* | *[!A-Za-z0-9._-]*) die "别名只能包含字母、数字、点、下划线和连字符，且不能以 - 开头: $1" ;;
    esac
}

set_password() {
    check_alias "$1"
    IFS= read -rs -p "为 $1 输入密码: " first || die "未读取到输入"
    echo >&2
    IFS= read -rs -p "再次输入确认: " second || die "未读取到输入"
    echo >&2
    [ -n "$first" ] || die "密码为空，未保存"
    [ "$first" = "$second" ] || die "两次输入不一致，未保存"
    printf '%s' "$first" | cred set "$1"
    echo "已保存到 Windows 凭据管理器: $TARGET_PREFIX$1"
}

add_host() {
    alias_name=$1
    target=$2
    check_alias "$alias_name"

    case "$target" in
        *@*) ;;
        *) die "目标格式应为 user@host[:port]: $target" ;;
    esac
    user=${target%%@*}
    host_port=${target#*@}
    host=${host_port%%:*}
    port=22
    [ "$host_port" = "$host" ] || port=${host_port#*:}
    case "$user" in '' | *[!A-Za-z0-9._-]*) die "用户名不合法: $user" ;; esac
    case "$host" in '' | *[!A-Za-z0-9._-]*) die "主机地址不合法: $host" ;; esac
    case "$port" in '' | *[!0-9]*) die "端口不合法: $port" ;; esac

    mkdir -p "$HOME/.ssh"
    if [ -f "$SSH_CONFIG" ] && awk -v a="$alias_name" '
        tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i == a) found = 1 }
        END { exit !found }' "$SSH_CONFIG"; then
        die "别名已存在于 $SSH_CONFIG: $alias_name"
    fi

    printf '\nHost %s\n    HostName %s\n    User %s\n    Port %s\n' \
        "$alias_name" "$host" "$user" "$port" >>"$SSH_CONFIG"
    echo "已添加 Host $alias_name -> $user@$host:$port"

    # 无终端（如被脚本调用）时读到 EOF，跳过录入密码
    printf '是否为 %s 录入密码到凭据管理器？密钥登录选 n [Y/n] ' "$alias_name"
    read -r answer || { answer=n; echo; }
    case "$answer" in
        '' | [Yy]*) set_password "$alias_name" ;;
        *) echo "已跳过；需要时执行: zssh --set $alias_name" ;;
    esac
}

# 逗号分隔列表 $1 中第一个也出现在列表 $2 中的算法（结果按 $1 的顺序）
first_common() {
    old_ifs=$IFS
    IFS=,
    for algo in $1; do
        case ",$2," in
            *",$algo,"*) IFS=$old_ifs; echo "$algo"; return 0 ;;
        esac
    done
    IFS=$old_ifs
    return 1
}

# 服务器在 KEXINIT 中提供的某类算法；有 ProxyJump 时取最后一次握手（即目标主机）
peer_offer() {
    printf '%s\n' "$probe_log" | sed -n '/peer server KEXINIT proposal/,/compression stoc/p' |
        sed -n "s/^debug2: $1: //p" | tail -n 1
}

# ssh 实际协商出的算法：$1 为 "debug1: kex: " 之后的前缀，$2 为取第几个字段
negotiated() {
    printf '%s\n' "$probe_log" | sed -n "s/^debug1: kex: $1//p" | tail -n 1 | awk -v f="$2" '{ print $f }'
}

effective_option() {
    printf '%s\n' "$effective" | awk -v k="$1" '$1 == k { print $2; exit }'
}

# 只握手、不认证（PreferredAuthentications=none），不写 known_hosts，不复用连接
probe_host() {
    alias_name=$1
    check_alias "$alias_name"
    effective=$("$SSH" -G "$alias_name" 2>/dev/null) || die "无法解析别名: $alias_name"
    probe_log=$("$SSH" -vv -o BatchMode=yes -o ConnectTimeout=10 -o ControlPath=none \
        -o PreferredAuthentications=none -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no \
        "$alias_name" true </dev/null 2>&1) || true

    version=$(printf '%s\n' "$probe_log" | sed -n 's/.*remote software version //p' | tail -n 1)
    echo "目标: $(effective_option user)@$(effective_option hostname):$(effective_option port)  服务器: ${version:-未知}"
    if [ -z "$(peer_offer 'host key algorithms')" ]; then
        printf '%s\n' "$probe_log" | grep -v '^debug' | tail -n 5 >&2
        die "未能完成握手，无法获取服务器算法"
    fi

    suggestions=
    cipher=
    for spec in '主机密钥|host key algorithms|hostkeyalgorithms|HostKeyAlgorithms|host key algorithm: |1' \
        '密钥交换|KEX algorithms|kexalgorithms|KexAlgorithms|algorithm: |1' \
        '加密算法|ciphers ctos|ciphers|Ciphers|client->server cipher: |1' \
        'MAC|MACs ctos|macs|MACs|client->server cipher: |3'; do
        label=${spec%%|*}; rest=${spec#*|}
        debug_key=${rest%%|*}; rest=${rest#*|}
        g_key=${rest%%|*}; rest=${rest#*|}
        option=${rest%%|*}; rest=${rest#*|}
        neg_prefix=${rest%%|*}; neg_field=${rest#*|}

        # AEAD 加密算法自带完整性校验，不再协商 MAC
        if [ "$option" = MACs ]; then
            case "$cipher" in *gcm* | *chacha20*) echo "  $label: 随加密算法 $cipher 内置，无需协商"; continue ;; esac
        fi
        offer=$(peer_offer "$debug_key")
        # 可协商时优先显示 ssh 实际选中的算法；需补充时按服务器偏好挑本机支持的第一个
        if algo=$(first_common "$(effective_option "$g_key")" "$offer"); then
            actual=$(negotiated "$neg_prefix" "$neg_field")
            algo=${actual:-$algo}
            echo "  $label: 可协商 ($algo)"
        elif algo=$(first_common "$offer" "$("$SSH" -Q "$option" | tr '\n' ',')"); then
            echo "  $label: 不可协商，需添加 $option +$algo"
            suggestions="$suggestions$option +$algo
"
        else
            echo "  $label: 本机 ssh 已不支持服务器提供的任何算法 ($offer)，只能升级服务器的 SSH"
        fi
        if [ "$option" = Ciphers ]; then
            cipher=${algo:-}
        fi
    done

    # 7.2 以前的 OpenSSH 只认 ssh-rsa（SHA-1）签名的 RSA 公钥；6.5 以前不认识 ed25519
    ver=$(printf '%s\n' "$version" | sed -n 's/^OpenSSH_\([0-9]*\)\.\([0-9]*\).*/\1 \2/p')
    if [ -n "$ver" ]; then
        ver_num=$((${ver% *} * 100 + ${ver#* }))
        if [ "$ver_num" -lt 702 ] && ! first_common ssh-rsa "$(effective_option pubkeyacceptedalgorithms)" >/dev/null; then
            suggestions="${suggestions}PubkeyAcceptedAlgorithms +ssh-rsa   # 仅使用 RSA 密钥登录时需要
"
        fi
        if [ "$ver_num" -lt 605 ]; then
            echo "  注意: 服务器早于 OpenSSH 6.5，不支持 ed25519 密钥，密钥登录请使用 RSA 密钥"
        fi
    fi

    echo
    if [ -z "$suggestions" ]; then
        echo "当前配置可以与该服务器完成协商，无需修改。"
        return 0
    fi
    echo "请在 ~/.ssh/config（或其 Include 的文件）的 Host $alias_name 段中手动加入："
    printf '%s' "$suggestions" | sed 's/^/    /'
}

# 用凭据管理器中的密码（如有）执行 ssh/scp 并替换当前进程；Git Bash 下 ControlMaster 不可靠，不做连接复用
#   $1 程序；$2 为 1 时允许用户自己回答提示；其余为参数
exec_with_auth() {
    tool=$1
    allow_prompt=$2
    shift 2
    set -- -o StrictHostKeyChecking=accept-new -o NumberOfPasswordPrompts=1 -o ConnectTimeout=10 "$@"
    # 允许人工回答提示且凭据管理器里没有该别名的密码：交给原生程序，提示由用户自己输入
    if [ "$allow_prompt" = 1 ] && ! cred get "$alias_name" >/dev/null 2>&1; then
        exec "$tool" "$@"
    fi
    # 挂上 askpass：密钥认证成功时不会回调；需要密码时从凭据管理器读取，没有该凭据则认证失败，不会卡住
    ZSSH_ASKPASS_ALIAS=$alias_name SSH_ASKPASS=$self SSH_ASKPASS_REQUIRE=force exec "$tool" "$@"
}

# 盘符路径转成 Git Bash 路径；scp 会把其他含冒号的本地路径当成远程地址，加 ./ 前缀避免误判
local_path() {
    case "$1" in
        [A-Za-z]:[\\/]*) cygpath -u "$1" ;;
        /* | ./* | ../*) echo "$1" ;;
        *:*) echo "./$1" ;;
        *) echo "$1" ;;
    esac
}

# $1 为 put 或 get，$2 别名，$3 源路径，$4 目标路径；scp -r 同时适用于文件和目录
transfer() {
    alias_name=$2
    check_alias "$alias_name"
    if [ "$1" = put ]; then
        src=$(local_path "$3")
        [ -e "$src" ] || die "本地路径不存在: $3"
        dst="$alias_name:$4"
    else
        src="$alias_name:$3"
        dst=$(local_path "$4")
    fi
    prompt=0
    [ ! -t 0 ] || prompt=1
    exec_with_auth "$SCP" "$prompt" -r "$src" "$dst"
}

forward() {
    alias_name=$1
    check_alias "$alias_name"
    case "$2" in
        -* | *[!A-Za-z0-9._:-]*) die "转发规则格式应为 [bind:]port:host:hostport: $2" ;;
        *:*:*) ;;
        *) die "转发规则格式应为 [bind:]port:host:hostport: $2" ;;
    esac
    [ -t 0 ] || die "--forward 会一直运行直到 Ctrl-C，需要在终端中使用"
    echo "经 $alias_name 建立本地端口转发 $2，Ctrl-C 结束" >&2
    exec_with_auth "$SSH" 1 -N -o ExitOnForwardFailure=yes -L "$2" "$alias_name"
}

case "${1:-}" in
    --set)
        [ $# -eq 2 ] || usage
        set_password "$2"
        exit 0
        ;;
    --put | --get)
        [ $# -eq 4 ] || usage
        transfer "${1#--}" "$2" "$3" "$4"
        ;;
    --forward)
        [ $# -eq 3 ] || usage
        forward "$2" "$3"
        ;;
    --add)
        [ $# -eq 3 ] || usage
        add_host "$2" "$3"
        exit 0
        ;;
    --probe)
        [ $# -eq 2 ] || usage
        probe_host "$2"
        exit 0
        ;;
    -t)
        [ $# -ge 2 ] || usage
        [ -t 0 ] || die "-t 需要在终端中使用；非交互调用请去掉 -t 并提供远程命令"
        interactive=1
        shift
        ;;
    '' | -*) usage ;;
esac
[ -n "${interactive:-}" ] || [ $# -ge 2 ] || usage

alias_name=$1
shift
check_alias "$alias_name"

# -t 时分配终端，无凭据则提示交给用户
exec_with_auth "$SSH" "${interactive:-0}" ${interactive:+-t} "$alias_name" "$@"
